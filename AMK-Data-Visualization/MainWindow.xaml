<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AMK.DataVisualization.App.Controls"
    Title="Amk-Horizon-New-Chart">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowDefinitions="Auto,32,*,24">
        <MenuBar>
            <MenuBarItem Title="Файл">
                <MenuFlyoutItem
                    Text="Открыть файл данных..."
                    Click="OpenFileButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Text="Выход"
                    Click="ExitMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Настройки подключения" />
            <MenuBarItem Title="Метрология" />
            <MenuBarItem Title="Конструктор файлов" />
            <MenuBarItem Title="Заметки">
                <MenuFlyoutItem
                    Text="Журнал заметок текущего файла..."
                    IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem Title="Логи" />
            <MenuBarItem Title="Проверить обновления" />
            <MenuBarItem Title="Документация" />
        </MenuBar>

        <Grid
            Grid.Row="1"
            Padding="10,4,10,2"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox
                x:Name="DualModeCheckBox"
                Width="130"
                MinHeight="0"
                VerticalAlignment="Center"
                Content="Двойной режим"
                FontWeight="SemiBold" />

            <Button
                Grid.Column="1"
                Width="120"
                Height="24"
                Margin="5,0,0,0"
                Padding="8,0"
                VerticalAlignment="Center"
                Content="Схема прибора"
                FontWeight="SemiBold"
                IsEnabled="False" />

            <StackPanel
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <TextBox
                    x:Name="XRangeFromTextBox"
                    Width="50"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    InputScope="Number" />
                <TextBlock
                    Width="12"
                    VerticalAlignment="Center"
                    Text="-"
                    TextAlignment="Center" />
                <TextBox
                    x:Name="XRangeToTextBox"
                    Width="50"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    InputScope="Number" />
                <Button
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="✓"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Применить" />
                <Button
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="↺"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Сбросить" />
                <Button
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="↓"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Загрузить" />
                <Button
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="✂"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Вырезать отрезок" />
                <Button
                    Width="65"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="↺ Zoom"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Сбросить Zoom" />
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <CheckBox
                    x:Name="Chart1SurfCheckBox"
                    Width="58"
                    MinHeight="0"
                    VerticalAlignment="Center"
                    Content="Поток"
                    FontWeight="SemiBold" />
                <TextBox
                    x:Name="Chart1SurfTextBox"
                    Width="45"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    HorizontalContentAlignment="Center"
                    InputScope="Number"
                    Text="100" />
                <Button
                    Width="32"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="▶"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Старт/Стоп опроса прибора" />
                <Button
                    Width="80"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="Включить"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Включение/Отключение прибора" />
            </StackPanel>

            <StackPanel
                Grid.Column="4"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <TextBlock
                    Width="18"
                    VerticalAlignment="Center"
                    Text="⌖"
                    TextAlignment="Center" />
                <TextBox
                    x:Name="CursorXTextBox"
                    Width="45"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    HorizontalContentAlignment="Center"
                    IsReadOnly="True" />
                <TextBlock
                    Width="10"
                    VerticalAlignment="Center"
                    Text=":"
                    TextAlignment="Center" />
                <TextBox
                    x:Name="CursorY1TextBox"
                    Width="95"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    HorizontalContentAlignment="Center"
                    IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="5,2,5,2">
            <controls:LineChartControl x:Name="GraphControl" />

            <StackPanel
                Margin="0,8,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="22"
                    Height="20"
                    MinWidth="0"
                    Padding="0"
                    Content="↶"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Отменить последний zoom" />
                <CheckBox
                    x:Name="Chart1ShowNotesCheckBox"
                    MinHeight="0"
                    Content="Показать заметки"
                    IsChecked="True" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="150,200,200,24,*">
            <TextBlock
                x:Name="StatusTextBlock"
                Padding="8,3,4,0"
                Text="Готов"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                Padding="8,3,4,0"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                Padding="8,3,4,0"
                TextTrimming="CharacterEllipsis" />
            <FontIcon
                x:Name="FolderStatusIcon"
                Grid.Column="3"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Glyph="&#xE8B7;"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="LoadedFileStatusTextBlock"
                Grid.Column="4"
                Padding="8,3,4,0"
                Text="Файл не загружен"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
