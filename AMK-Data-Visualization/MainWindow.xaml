<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AMK.DataVisualization.App.Controls"
    Title="Визуализация данных">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowDefinitions="Auto,32,*,24">
        <StackPanel Orientation="Horizontal">
            <MenuBar Padding="0">
                <MenuBarItem Title="Файл">
                    <MenuFlyoutItem
                        Text="Открыть файл данных..."
                        Click="OpenFileButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Выход"
                        Click="ExitMenuItem_Click" />
                </MenuBarItem>
            </MenuBar>

            <Button
                MinWidth="0"
                MinHeight="0"
                Padding="12,0"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Настройки подключения"
                Background="Transparent"
                BorderThickness="0"
                Content="Настройки подключения"
                Click="ConnectionSettingsMenuItem_Click" />

            <Button
                MinWidth="0"
                MinHeight="0"
                Padding="12,0"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Метрология"
                Background="Transparent"
                BorderThickness="0"
                Content="Метрология"
                Click="MetrologyMenuItem_Click" />

            <MenuBar Padding="0">
                <MenuBarItem Title="Конструктор файлов" />
                <MenuBarItem Title="Заметки">
                    <MenuFlyoutItem
                        Text="Журнал заметок текущего файла..."
                        IsEnabled="False" />
                </MenuBarItem>
                <MenuBarItem Title="Логи" />
            </MenuBar>

            <Button
                x:Name="UpdateCheckButton"
                MinWidth="0"
                MinHeight="0"
                Padding="12,0"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Проверить обновления"
                Background="Transparent"
                BorderThickness="0"
                Content="Проверить обновления"
                Click="CheckForUpdatesButton_Click" />

            <MenuBar Padding="0">
                <MenuBarItem Title="Документация" />
            </MenuBar>
        </StackPanel>

        <Grid
            Grid.Row="1"
            Padding="10,4,10,2"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox
                x:Name="DualModeCheckBox"
                MinHeight="0"
                VerticalAlignment="Center"
                Content="Двойной режим"
                FontWeight="SemiBold"
                Checked="DualModeCheckBox_Checked"
                Unchecked="DualModeCheckBox_Unchecked" />

            <Button
                x:Name="Graph1SchematicButton"
                Grid.Column="1"
                Width="120"
                Height="24"
                Margin="4,0,0,0"
                Padding="8,0"
                VerticalAlignment="Center"
                Content="Схема прибора"
                FontWeight="SemiBold"
                Click="Graph1SchematicButton_Click" />

            <StackPanel
                Grid.Column="2"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <TextBox
                    x:Name="XRangeFromTextBox"
                    Width="50"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    InputScope="Number" />
                <TextBlock
                    Width="12"
                    VerticalAlignment="Center"
                    Text="-"
                    TextAlignment="Center" />
                <TextBox
                    x:Name="XRangeToTextBox"
                    Width="50"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    InputScope="Number" />
                <Button
                    x:Name="Graph1ApplyRangeButton"
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="✓"
                    Click="Graph1ApplyRangeButton_Click"
                    ToolTipService.ToolTip="Применить" />
                <Button
                    x:Name="Graph1ResetRangeButton"
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="↺"
                    Click="Graph1ResetRangeButton_Click"
                    ToolTipService.ToolTip="Сбросить" />
                <Button
                    x:Name="Graph1SaveRangeButton"
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="↓"
                    Click="Graph1SaveRangeButton_Click"
                    ToolTipService.ToolTip="Сохранить выбранный отрезок" />
                <Button
                    x:Name="Graph1CutRangeButton"
                    Width="26"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="✂"
                    Click="Graph1CutRangeButton_Click"
                    ToolTipService.ToolTip="Вырезать отрезок" />
                <Button
                    x:Name="Graph1ResetZoomButton"
                    Width="65"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="↺ Zoom"
                    Click="Graph1ResetZoomButton_Click"
                    ToolTipService.ToolTip="Сбросить Zoom" />
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <CheckBox
                    x:Name="Chart1SurfCheckBox"
                    MinHeight="0"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Content="Поток"
                    FontWeight="SemiBold"
                    Checked="Chart1SurfCheckBox_Changed"
                    Unchecked="Chart1SurfCheckBox_Changed" />
                <TextBox
                    x:Name="Chart1SurfTextBox"
                    Width="45"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    HorizontalContentAlignment="Center"
                    InputScope="Number"
                    Text="100"
                    LostFocus="Chart1SurfTextBox_LostFocus" />
                <Button
                    x:Name="PollingToggleButton"
                    Width="32"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="▶"
                    Click="PollingToggleButton_Click"
                    ToolTipService.ToolTip="Старт/Стоп опроса прибора" />
                <Button
                    x:Name="ConnectionToggleButton"
                    Width="80"
                    Height="24"
                    MinWidth="0"
                    Padding="0"
                    Content="Включить"
                    FontWeight="SemiBold"
                    Click="ConnectionToggleButton_Click"
                    ToolTipService.ToolTip="Включение/Отключение прибора" />
            </StackPanel>

            <StackPanel
                Grid.Column="4"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    Width="18"
                    VerticalAlignment="Center"
                    Text="⌖"
                    TextAlignment="Center" />
                <TextBox
                    x:Name="CursorXTextBox"
                    Width="45"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    HorizontalContentAlignment="Center"
                    IsReadOnly="True" />
                <TextBlock
                    Width="10"
                    VerticalAlignment="Center"
                    Text=":"
                    TextAlignment="Center" />
                <TextBox
                    x:Name="CursorY1TextBox"
                    Width="95"
                    Height="24"
                    MinHeight="0"
                    Padding="4,1"
                    HorizontalContentAlignment="Center"
                    IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="5,2,5,2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="Graph1Row" Height="*" />
                <RowDefinition x:Name="Chart2TopGapRow" Height="0" />
                <RowDefinition x:Name="Chart2PanelRow" Height="0" />
                <RowDefinition x:Name="Chart2BottomGapRow" Height="0" />
                <RowDefinition x:Name="Graph2Row" Height="0" />
            </Grid.RowDefinitions>

            <controls:LineChartControl x:Name="GraphControl" />

            <StackPanel
                Margin="0,8,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="Graph1UndoZoomButton"
                    Width="22"
                    Height="20"
                    MinWidth="0"
                    Padding="0"
                    Content="↶"
                    IsEnabled="False"
                    Click="Graph1UndoZoomButton_Click"
                    ToolTipService.ToolTip="Отменить последний zoom" />
                <CheckBox
                    x:Name="Chart1ShowNotesCheckBox"
                    MinHeight="0"
                    Content="Показать заметки"
                    IsChecked="True" />
            </StackPanel>

            <Grid
                x:Name="Chart2ControlPanel"
                Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Collapsed">
                <StackPanel
                    Margin="10,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="Graph2SchematicButton"
                        Width="140"
                        Height="24"
                        MinWidth="0"
                        Padding="8,0"
                        Content="Схема прибора"
                        FontWeight="SemiBold"
                        Click="Graph2SchematicButton_Click" />
                    <TextBox
                        x:Name="XRange2FromTextBox"
                        Width="50"
                        Height="24"
                        MinHeight="0"
                        Padding="4,1"
                        InputScope="Number" />
                    <TextBlock
                        Width="12"
                        VerticalAlignment="Center"
                        Text="-"
                        TextAlignment="Center" />
                    <TextBox
                        x:Name="XRange2ToTextBox"
                        Width="50"
                        Height="24"
                        MinHeight="0"
                        Padding="4,1"
                        InputScope="Number" />
                    <Button
                        x:Name="Graph2ApplyRangeButton"
                        Width="26"
                        Height="24"
                        MinWidth="0"
                        Padding="0"
                        Content="✓"
                        Click="Graph2ApplyRangeButton_Click"
                        ToolTipService.ToolTip="Применить" />
                    <Button
                        x:Name="Graph2ResetRangeButton"
                        Width="26"
                        Height="24"
                        MinWidth="0"
                        Padding="0"
                        Content="↺"
                        Click="Graph2ResetRangeButton_Click"
                        ToolTipService.ToolTip="Сбросить" />
                    <Button
                        x:Name="Graph2ResetZoomButton"
                        Width="65"
                        Height="24"
                        MinWidth="0"
                        Padding="0"
                        Content="↺ Zoom"
                        Click="Graph2ResetZoomButton_Click"
                        ToolTipService.ToolTip="Сбросить Zoom" />
                    <CheckBox
                        x:Name="Chart2SurfCheckBox"
                        MinHeight="0"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Content="Поток"
                        FontWeight="SemiBold"
                        Checked="Chart2SurfCheckBox_Changed"
                        Unchecked="Chart2SurfCheckBox_Changed" />
                    <TextBox
                        x:Name="Chart2SurfTextBox"
                        Width="45"
                        Height="24"
                        MinHeight="0"
                        Padding="4,1"
                        HorizontalContentAlignment="Center"
                        InputScope="Number"
                        Text="100"
                        LostFocus="Chart2SurfTextBox_LostFocus" />
                    <Button
                        x:Name="Graph2ModeButton"
                        Width="24"
                        Height="24"
                        MinWidth="0"
                        Padding="0"
                        ToolTipService.ToolTip="Режим данных графика 2">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Glyph="&#xE713;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem
                                    x:Name="Graph2LinkedModeMenuItem"
                                    Text="Стандартный режим"
                                    Click="Graph2LinkedModeMenuItem_Click" />
                                <ToggleMenuFlyoutItem
                                    x:Name="Graph2IndependentModeMenuItem"
                                    Text="Отдельный файл"
                                    Click="Graph2IndependentModeMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="Graph2OpenFileButton"
                        Width="24"
                        Height="24"
                        MinWidth="0"
                        Padding="0"
                        Click="OpenGraph2FileButton_Click"
                        ToolTipService.ToolTip="Открыть файл для графика 2"
                        Visibility="Collapsed">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Glyph="&#xE8B7;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Margin="0,2,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        Width="18"
                        VerticalAlignment="Center"
                        Text="⌖"
                        TextAlignment="Center" />
                    <TextBox
                        x:Name="Cursor2XTextBox"
                        Width="45"
                        Height="24"
                        MinHeight="0"
                        Padding="4,1"
                        HorizontalContentAlignment="Center"
                        IsReadOnly="True"
                        Text="—" />
                    <TextBlock
                        Width="10"
                        VerticalAlignment="Center"
                        Text=":"
                        TextAlignment="Center" />
                    <TextBox
                        x:Name="Cursor2Y1TextBox"
                        Width="95"
                        Height="24"
                        MinHeight="0"
                        Padding="4,1"
                        HorizontalContentAlignment="Center"
                        IsReadOnly="True"
                        Text="—" />
                </StackPanel>
            </Grid>

            <controls:LineChartControl
                x:Name="Graph2Control"
                Grid.Row="4"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="Graph2OverlayControls"
                Grid.Row="4"
                Margin="0,8,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="Collapsed">
                <Button
                    x:Name="Graph2UndoZoomButton"
                    Width="22"
                    Height="20"
                    MinWidth="0"
                    Padding="0"
                    Content="↶"
                    IsEnabled="False"
                    Click="Graph2UndoZoomButton_Click"
                    ToolTipService.ToolTip="Отменить последний zoom" />
                <CheckBox
                    x:Name="Chart2ShowNotesCheckBox"
                    MinHeight="0"
                    Content="Показать заметки"
                    IsChecked="True" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="150,200,200,24,*">
            <TextBlock
                x:Name="StatusTextBlock"
                Padding="8,3,4,0"
                Text="Готов"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                Padding="8,3,4,0"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                Padding="8,3,4,0"
                TextTrimming="CharacterEllipsis" />
            <FontIcon
                x:Name="FolderStatusIcon"
                Grid.Column="3"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Glyph="&#xE8B7;"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="LoadedFileStatusTextBlock"
                Grid.Column="4"
                Padding="8,3,4,0"
                Text="Файл не загружен"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
