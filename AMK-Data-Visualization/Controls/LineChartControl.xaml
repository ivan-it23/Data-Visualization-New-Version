<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AMK.DataVisualization.App.Controls.LineChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Canvas
            x:Name="ChartCanvas"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            PointerPressed="ChartCanvas_PointerPressed"
            PointerMoved="ChartCanvas_PointerMoved"
            PointerReleased="ChartCanvas_PointerReleased"
            PointerCaptureLost="ChartCanvas_PointerCaptureLost"
            SizeChanged="ChartCanvas_SizeChanged" />

        <ScrollBar
            x:Name="HorizontalAxisScrollBar"
            Height="14"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="Прокрутка графика по оси X"
            IsTabStop="True"
            Orientation="Horizontal"
            Scroll="HorizontalAxisScrollBar_Scroll"
            Visibility="Collapsed" />

        <ScrollBar
            x:Name="VerticalAxisScrollBar"
            Width="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Прокрутка графика по оси Y"
            IsTabStop="True"
            Orientation="Vertical"
            Scroll="VerticalAxisScrollBar_Scroll"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
