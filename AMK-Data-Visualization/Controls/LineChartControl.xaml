<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AMK.DataVisualization.App.Controls.LineChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Canvas
            x:Name="ChartCanvas"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            PointerPressed="ChartCanvas_PointerPressed"
            PointerMoved="ChartCanvas_PointerMoved"
            PointerReleased="ChartCanvas_PointerReleased"
            PointerCaptureLost="ChartCanvas_PointerCaptureLost"
            RightTapped="ChartCanvas_RightTapped"
            SizeChanged="ChartCanvas_SizeChanged" />

        <ScrollBar
            x:Name="HorizontalAxisScrollBar"
            Canvas.ZIndex="100"
            Height="16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="Прокрутка графика по оси X"
            IndicatorMode="MouseIndicator"
            IsTabStop="True"
            Orientation="Horizontal"
            Scroll="HorizontalAxisScrollBar_Scroll"
            Visibility="Collapsed" />

        <ScrollBar
            x:Name="VerticalAxisScrollBar"
            Canvas.ZIndex="100"
            Width="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Прокрутка графика по оси Y"
            IndicatorMode="MouseIndicator"
            IsTabStop="True"
            Orientation="Vertical"
            Scroll="VerticalAxisScrollBar_Scroll"
            Visibility="Collapsed" />

        <!-- Hit-transparent layer for interactive on-chart overlays (gear/eye).
             Kept separate from ChartCanvas so overlay clicks do not reach the
             chart's drag-zoom pointer handlers. -->
        <Canvas
            x:Name="OverlayCanvas"
            Canvas.ZIndex="110"
            Background="{x:Null}"
            IsHitTestVisible="True" />
    </Grid>
</UserControl>
