<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.Views.WindowScaleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Масштаб окна">

    <Grid
        x:Name="RootGrid"
        Padding="20"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="100% соответствует эталонному размеру при масштабе Windows 125%. Системный DPI компенсируется автоматически."
            TextWrapping="Wrap" />

        <StackPanel
            x:Name="OptionsPanel"
            Grid.Row="1"
            VerticalAlignment="Center"
            Spacing="4" />

        <Button
            Grid.Row="2"
            HorizontalAlignment="Right"
            Content="Закрыть"
            Click="CloseButton_Click" />
    </Grid>
</Window>
