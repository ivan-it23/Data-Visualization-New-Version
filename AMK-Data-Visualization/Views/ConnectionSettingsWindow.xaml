<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.Views.ConnectionSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройки подключения">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Подключение к прибору" FontSize="20" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock VerticalAlignment="Center" Text="Порт:" />
                    <ComboBox
                        x:Name="PortComboBox"
                        Grid.Column="1"
                        MinWidth="210"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Выберите COM-порт" />
                    <Button
                        Grid.Column="2"
                        Content="Обновить"
                        Click="RefreshPortsButton_Click" />
                </Grid>
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                    <TextBlock Grid.ColumnSpan="2" Text="Состояние" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Подключение:" />
                    <TextBlock x:Name="ConnectionStateTextBlock" Grid.Row="1" Grid.Column="1" Text="Отключено" />
                    <TextBlock Grid.Row="2" Text="Последний кадр:" />
                    <TextBlock x:Name="LastFrameTextBlock" Grid.Row="2" Grid.Column="1" Text="—" />
                    <TextBlock Grid.Row="3" Text="Пакеты / ошибки:" />
                    <TextBlock x:Name="PacketsTextBlock" Grid.Row="3" Grid.Column="1" Text="0 / 0" />
                    <TextBlock Grid.Row="4" Text="Прибор:" />
                    <TextBlock x:Name="DeviceInfoTextBlock" Grid.Row="4" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Text="Записано кадров:" />
                    <TextBlock x:Name="RecordedFramesTextBlock" Grid.Row="5" Grid.Column="1" Text="0" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="10">
                <TextBlock Text="Опрос и запись" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock VerticalAlignment="Center" Text="Интервал опроса, мс:" />
                    <NumberBox
                        x:Name="PollIntervalNumberBox"
                        Grid.Column="1"
                        Minimum="500"
                        Maximum="30000"
                        SmallChange="100"
                        SpinButtonPlacementMode="Inline"
                        Value="2000" />
                </Grid>
                <CheckBox x:Name="RecordingCheckBox" Content="Записывать принятые кадры" IsChecked="True" />
                <CheckBox
                    x:Name="AppendCheckBox"
                    Content="Продолжить запись в существующий файл"
                    Checked="RecordingOptionChanged"
                    Unchecked="RecordingOptionChanged" />
                <CheckBox
                    x:Name="ShowFullFileCheckBox"
                    Margin="24,0,0,0"
                    Content="Показывать на графике весь дополняемый файл"
                    IsEnabled="False" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox
                        x:Name="RecordPathTextBox"
                        IsReadOnly="True"
                        PlaceholderText="Папка для нового файла записи" />
                    <Button Grid.Column="1" Content="Выбрать..." Click="BrowseRecordPathButton_Click" />
                </Grid>
                <TextBlock
                    x:Name="RecordFileTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Файл записи будет создан после получения первого кадра"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock
                    x:Name="OperationMessageTextBlock"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="ConnectButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Content="Подключить"
                    Click="ConnectButton_Click" />
                <Button
                    x:Name="DisconnectButton"
                    Grid.Column="2"
                    MinWidth="110"
                    Content="Отключить"
                    Click="DisconnectButton_Click"
                    IsEnabled="False" />
                <Button Grid.Column="3" MinWidth="90" Content="Закрыть" Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
