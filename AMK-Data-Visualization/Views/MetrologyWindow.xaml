<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.Views.MetrologyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="МЕТРОЛОГИЯ">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Canvas x:Name="ContentCanvas" Width="1180" Height="580" Margin="12">
            <!-- Геометрия зонда: порядок полей соответствует эталонному окну. -->
            <Border Canvas.Left="10" Canvas.Top="8" Width="320" Height="375" BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1" CornerRadius="2" />
            <Border Canvas.Left="22" Canvas.Top="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <TextBlock Padding="5,0" Text="Геометрия зонда" FontWeight="Bold" />
            </Border>
            <TextBlock Canvas.Left="95" Canvas.Top="31" Width="85" Text="L1, мм" TextAlignment="Center" />
            <TextBlock Canvas.Left="195" Canvas.Top="31" Width="85" Text="L2, мм" TextAlignment="Center" />

            <TextBlock Canvas.Left="32" Canvas.Top="68" Width="55" Text="T1" TextAlignment="Center" />
            <TextBox x:Name="L1T1TextBox" Canvas.Left="95" Canvas.Top="62" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="L2T1TextBox" Canvas.Left="195" Canvas.Top="62" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="32" Canvas.Top="103" Width="55" Text="T2" TextAlignment="Center" />
            <TextBox x:Name="L1T2TextBox" Canvas.Left="95" Canvas.Top="97" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="L2T2TextBox" Canvas.Left="195" Canvas.Top="97" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="32" Canvas.Top="138" Width="55" Text="T3" TextAlignment="Center" />
            <TextBox x:Name="L1T3TextBox" Canvas.Left="95" Canvas.Top="132" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="L2T3TextBox" Canvas.Left="195" Canvas.Top="132" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="32" Canvas.Top="173" Width="55" Text="T4" TextAlignment="Center" />
            <TextBox x:Name="L1T4TextBox" Canvas.Left="95" Canvas.Top="167" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="L2T4TextBox" Canvas.Left="195" Canvas.Top="167" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="32" Canvas.Top="208" Width="55" Text="T5" TextAlignment="Center" />
            <TextBox x:Name="L1T5TextBox" Canvas.Left="95" Canvas.Top="202" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="L2T5TextBox" Canvas.Left="195" Canvas.Top="202" Width="85" Height="30" MinHeight="0" Padding="5,2" />

            <TextBlock Canvas.Left="32" Canvas.Top="263" Width="55" Text="F1, кГц" TextAlignment="Center" />
            <TextBox x:Name="Frequency1TextBox" Canvas.Left="95" Canvas.Top="257" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="32" Canvas.Top="303" Width="55" Text="F2, кГц" TextAlignment="Center" />
            <TextBox x:Name="Frequency2TextBox" Canvas.Left="95" Canvas.Top="297" Width="85" Height="30" MinHeight="0" Padding="5,2" />
            <CheckBox x:Name="GeometryReadOnlyCheckBox" Canvas.Left="36" Canvas.Top="333" Height="34" MinHeight="0" Content="L/F только для чтения" Click="GeometryReadOnlyCheckBox_Click" />

            <!-- Воздушные калибровки. -->
            <Border Canvas.Left="344" Canvas.Top="8" Width="826" Height="375" BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1" CornerRadius="2" />
            <Border Canvas.Left="356" Canvas.Top="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <TextBlock Padding="5,0" Text="Воздушные калибровки" FontWeight="Bold" />
            </Border>
            <TextBlock Canvas.Left="382" Canvas.Top="23" Width="125" Height="36" FontSize="13" LineHeight="16" Text="Поправка фазы&#x0a;F1" TextAlignment="Center" ToolTipService.ToolTip="Поправка нуля разности фаз, полученная при калибровке в воздухе на частоте F1." />
            <TextBlock Canvas.Left="498" Canvas.Top="23" Width="125" Height="36" FontSize="13" LineHeight="16" Text="Порог амплитуды&#x0a;F1" TextAlignment="Center" ToolTipService.ToolTip="Минимальная амплитуда, при превышении которой канал считается рабочим на частоте F1." />
            <TextBlock Canvas.Left="646" Canvas.Top="23" Width="125" Height="36" FontSize="13" LineHeight="16" Text="Поправка фазы&#x0a;F2" TextAlignment="Center" ToolTipService.ToolTip="Поправка нуля разности фаз, полученная при калибровке в воздухе на частоте F2." />
            <TextBlock Canvas.Left="762" Canvas.Top="23" Width="125" Height="36" FontSize="13" LineHeight="16" Text="Порог амплитуды&#x0a;F2" TextAlignment="Center" ToolTipService.ToolTip="Минимальная амплитуда, при превышении которой канал считается рабочим на частоте F2." />
            <TextBlock x:Name="AirAttF1Header" Canvas.Left="878" Canvas.Top="23" Width="125" Height="36" FontSize="13" LineHeight="16" Text="Попр. затухания&#x0a;F1, дБ" TextAlignment="Center" ToolTipService.ToolTip="Воздушная поправка затухания на частоте F1, децибелы. Вычитается из затухания между приёмниками перед симметризацией. Есть только у приборов с новой прошивкой. Пустое поле означает, что поправка в приборе не задана; при записи в зонд вместо неё уходит ноль." />
            <TextBlock x:Name="AirAttF2Header" Canvas.Left="994" Canvas.Top="23" Width="125" Height="36" FontSize="13" LineHeight="16" Text="Попр. затухания&#x0a;F2, дБ" TextAlignment="Center" ToolTipService.ToolTip="Воздушная поправка затухания на частоте F2, децибелы. Вычитается из затухания между приёмниками перед симметризацией. Есть только у приборов с новой прошивкой. Пустое поле означает, что поправка в приборе не задана; при записи в зонд вместо неё уходит ноль." />

            <TextBlock Canvas.Left="362" Canvas.Top="68" Text="T1" />
            <TextBox x:Name="AirF1T1TextBox" Canvas.Left="392" Canvas.Top="62" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF1T1TextBox" Canvas.Left="508" Canvas.Top="62" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirF2T1TextBox" Canvas.Left="656" Canvas.Top="62" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF2T1TextBox" Canvas.Left="772" Canvas.Top="62" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF1T1TextBox" Canvas.Left="888" Canvas.Top="62" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF2T1TextBox" Canvas.Left="1004" Canvas.Top="62" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="362" Canvas.Top="103" Text="T2" />
            <TextBox x:Name="AirF1T2TextBox" Canvas.Left="392" Canvas.Top="97" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF1T2TextBox" Canvas.Left="508" Canvas.Top="97" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirF2T2TextBox" Canvas.Left="656" Canvas.Top="97" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF2T2TextBox" Canvas.Left="772" Canvas.Top="97" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF1T2TextBox" Canvas.Left="888" Canvas.Top="97" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF2T2TextBox" Canvas.Left="1004" Canvas.Top="97" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="362" Canvas.Top="138" Text="T3" />
            <TextBox x:Name="AirF1T3TextBox" Canvas.Left="392" Canvas.Top="132" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF1T3TextBox" Canvas.Left="508" Canvas.Top="132" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirF2T3TextBox" Canvas.Left="656" Canvas.Top="132" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF2T3TextBox" Canvas.Left="772" Canvas.Top="132" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF1T3TextBox" Canvas.Left="888" Canvas.Top="132" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF2T3TextBox" Canvas.Left="1004" Canvas.Top="132" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="362" Canvas.Top="173" Text="T4" />
            <TextBox x:Name="AirF1T4TextBox" Canvas.Left="392" Canvas.Top="167" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF1T4TextBox" Canvas.Left="508" Canvas.Top="167" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirF2T4TextBox" Canvas.Left="656" Canvas.Top="167" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF2T4TextBox" Canvas.Left="772" Canvas.Top="167" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF1T4TextBox" Canvas.Left="888" Canvas.Top="167" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF2T4TextBox" Canvas.Left="1004" Canvas.Top="167" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="362" Canvas.Top="208" Text="T5" />
            <TextBox x:Name="AirF1T5TextBox" Canvas.Left="392" Canvas.Top="202" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF1T5TextBox" Canvas.Left="508" Canvas.Top="202" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirF2T5TextBox" Canvas.Left="656" Canvas.Top="202" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="MinF2T5TextBox" Canvas.Left="772" Canvas.Top="202" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF1T5TextBox" Canvas.Left="888" Canvas.Top="202" Width="105" Height="30" MinHeight="0" Padding="5,2" />
            <TextBox x:Name="AirAttF2T5TextBox" Canvas.Left="1004" Canvas.Top="202" Width="105" Height="30" MinHeight="0" Padding="5,2" />

            <Rectangle Canvas.Left="362" Canvas.Top="248" Width="790" Height="1" Fill="{ThemeResource TextControlBorderBrush}" />
            <TextBlock Canvas.Left="362" Canvas.Top="270" Text="Сигнатура, 32 бита" />
            <TextBox x:Name="SignatureBinaryTextBox" Canvas.Left="508" Canvas.Top="263" Width="369" Height="30" MinHeight="0" Padding="5,2" IsReadOnly="True" FontFamily="Consolas" />
            <TextBlock Canvas.Left="362" Canvas.Top="312" Text="Палитра" />
            <TextBox x:Name="SignaturePaletteTextBox" Canvas.Left="425" Canvas.Top="305" Width="83" Height="30" MinHeight="0" Padding="5,2" IsReadOnly="True" />

            <!-- Идентификация зонда. -->
            <Border Canvas.Left="10" Canvas.Top="397" Width="1160" Height="76" BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1" CornerRadius="2" />
            <Border Canvas.Left="22" Canvas.Top="390" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <TextBlock Padding="5,0" Text="Идентификация зонда" FontWeight="Bold" />
            </Border>
            <TextBlock Canvas.Left="24" Canvas.Top="407" Text="Тип прибора" />
            <ComboBox x:Name="TypeComboBox" Canvas.Left="24" Canvas.Top="429" Width="165" />
            <TextBlock Canvas.Left="200" Canvas.Top="407" Text="Число передатчиков" />
            <ComboBox x:Name="TransmitterCountComboBox" Canvas.Left="200" Canvas.Top="429" Width="130" />
            <TextBlock Canvas.Left="342" Canvas.Top="407" Text="Модификация" />
            <ComboBox x:Name="ModificationComboBox" Canvas.Left="342" Canvas.Top="429" Width="130" />
            <!--
                Подписи отражают учётный смысл полей: значение из сигнатуры —
                серийный номер прибора (он же serial_number карточки в базе),
                а поле Serial структуры метрологии — номер корпуса.
            -->
            <TextBlock Canvas.Left="484" Canvas.Top="407" Text="Серийный №" />
            <TextBox x:Name="NumberTextBox" Canvas.Left="484" Canvas.Top="429" Width="90" Height="32" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="586" Canvas.Top="407" Text="Корпус №" />
            <TextBox x:Name="SerialTextBox" Canvas.Left="586" Canvas.Top="429" Width="125" Height="32" MinHeight="0" Padding="5,2" />
            <TextBlock Canvas.Left="723" Canvas.Top="407" Text="Положение R1" />
            <TextBlock Canvas.Left="930" Canvas.Top="407" Text="Прошивка" />
            <TextBox x:Name="FirmwareGenerationTextBox" Canvas.Left="930" Canvas.Top="429" Width="230" Height="32" MinHeight="0" Padding="5,2" IsReadOnly="True" />
            <ComboBox x:Name="RxPositionComboBox" Canvas.Left="723" Canvas.Top="429" Width="195" />

            <!--
                Оба ряда кнопок занимают всю ширину содержимого окна: четыре
                кнопки по 284 с зазором 8 и две по 576 с тем же зазором дают
                одинаковые левый и правый края.
            -->
            <Button x:Name="ReadDeviceButton" Canvas.Left="10" Canvas.Top="486" Width="284" Height="36" MinHeight="0" Content="Считать из зонда" FontWeight="Bold" Click="ReadDeviceButton_Click" />
            <Button x:Name="WriteDeviceButton" Canvas.Left="302" Canvas.Top="486" Width="284" Height="36" MinHeight="0" Content="Записать в зонд" FontWeight="Bold" Click="WriteDeviceButton_Click" />
            <Button Canvas.Left="594" Canvas.Top="486" Width="284" Height="36" MinHeight="0" Content="Открыть файл" FontWeight="Bold" Click="OpenFileButton_Click" />
            <Button Canvas.Left="886" Canvas.Top="486" Width="284" Height="36" MinHeight="0" Content="Сохранить файл" FontWeight="Bold" Click="SaveFileButton_Click" />
            <Button x:Name="AirCalibrationButton" Canvas.Left="10" Canvas.Top="534" Width="576" Height="36" MinHeight="0" Content="Автокалибровка нулей воздуха" FontWeight="Bold" Click="AirCalibrationButton_Click" />
            <Button x:Name="UploadToDatabaseButton" Canvas.Left="594" Canvas.Top="534" Width="576" Height="36" MinHeight="0" Content="Загрузить в базу данных" FontWeight="Bold" Click="UploadToDatabaseButton_Click" />
        </Canvas>
    </Grid>
</Window>
