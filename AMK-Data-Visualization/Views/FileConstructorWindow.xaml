<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.Views.FileConstructorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Конструктор файлов">

    <Grid
        x:Name="RootGrid"
        Padding="16"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Click="AddFilesButton_Click"
                Content="Добавить файлы..." />
            <Button
                Click="OpenAssemblyButton_Click"
                Content="Открыть сборку..." />
            <Button
                x:Name="RemoveButton"
                Click="RemoveButton_Click"
                Content="Удалить" />
            <Button
                x:Name="MoveUpButton"
                Click="MoveUpButton_Click"
                Content="Вверх" />
            <Button
                x:Name="MoveDownButton"
                Click="MoveDownButton_Click"
                Content="Вниз" />
        </StackPanel>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ListView
                x:Name="SegmentsListView"
                AutomationProperties.Name="Сегменты собираемого файла"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.ZoomMode="Disabled"
                SelectionChanged="SegmentsListView_SelectionChanged" />
        </Border>

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="2"
            MinHeight="40"
            TextWrapping="Wrap" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                x:Name="BusyProgressRing"
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsActive="False" />
            <Button
                x:Name="SaveAsButton"
                Grid.Column="1"
                Click="SaveAsButton_Click"
                Content="Сохранить как..."
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="ResaveButton"
                Grid.Column="2"
                Click="ResaveButton_Click"
                Content="Пересохранить" />
            <Button
                Grid.Column="3"
                Click="CloseButton_Click"
                Content="Закрыть" />
        </Grid>
    </Grid>
</Window>
