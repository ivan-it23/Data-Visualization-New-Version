<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.DataVisualization.App.Views.SchematicWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootGrid"
        Padding="12,12,12,4"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="10">
        <Grid.Resources>
        <Style x:Key="SchematicElementToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ElementBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ElementBorder.Opacity" Value="0.92" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ElementBorder.Opacity" Value="0.82" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ElementBorder.Opacity" Value="0.48" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="ElementBorder.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="ElementBorder.BorderBrush" Value="#FFFFD600" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="ElementBorder.BorderBrush" Value="#FFFFD600" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="4,0,0,5"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Схема прибора" />

            <Grid Grid.Row="1" HorizontalAlignment="Center" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="3"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton
                            x:Name="Transmitter5Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="T5"
                            Tag="Transmitter:4"
                            ToolTipService.ToolTip="Передатчик T5 - нажмите для выбора" />
                        <ToggleButton
                            x:Name="Transmitter3Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="T3"
                            Tag="Transmitter:2"
                            ToolTipService.ToolTip="Передатчик T3 - нажмите для выбора" />
                        <ToggleButton
                            x:Name="Transmitter1Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="T1"
                            Tag="Transmitter:0"
                            ToolTipService.ToolTip="Передатчик T1 - нажмите для выбора" />
                        <ToggleButton
                            x:Name="Receiver1Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="R1"
                            Tag="Receiver:0"
                            ToolTipService.ToolTip="Приёмник R1 - нажмите для выбора" />
                        <ToggleButton
                            x:Name="Receiver2Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="R2"
                            Tag="Receiver:1"
                            ToolTipService.ToolTip="Приёмник R2 - нажмите для выбора" />
                        <ToggleButton
                            x:Name="Transmitter2Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="T2"
                            Tag="Transmitter:1"
                            ToolTipService.ToolTip="Передатчик T2 - нажмите для выбора" />
                        <ToggleButton
                            x:Name="Transmitter4Button"
                            Width="58"
                            Height="35"
                            MinWidth="0"
                            Style="{StaticResource SchematicElementToggleButtonStyle}"
                            Click="SchematicElementButton_Click"
                            Content="T4"
                            Tag="Transmitter:3"
                            ToolTipService.ToolTip="Передатчик T4 - нажмите для выбора" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ToggleButton
                        x:Name="SilentReceiver1Button"
                        Width="64"
                        Height="35"
                        MinWidth="0"
                        Style="{StaticResource SchematicElementToggleButtonStyle}"
                        Padding="2,0"
                        Click="SchematicElementButton_Click"
                        Content="Молч. R1"
                        FontSize="11"
                        Tag="SilentTx:0"
                        ToolTipService.ToolTip="Молчащий передатчик для R1 - нажмите для выбора" />
                    <ToggleButton
                        x:Name="SilentReceiver2Button"
                        Width="64"
                        Height="35"
                        MinWidth="0"
                        Style="{StaticResource SchematicElementToggleButtonStyle}"
                        Padding="2,0"
                        Click="SchematicElementButton_Click"
                        Content="Молч. R2"
                        FontSize="11"
                        Tag="SilentTx:1"
                        ToolTipService.ToolTip="Молчащий передатчик для R2 - нажмите для выбора" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="4,0,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Частота:" />
            <ComboBox
                x:Name="FrequencyComboBox"
                Width="125"
                AutomationProperties.Name="Частота"
                SelectionChanged="FrequencyComboBox_SelectionChanged">
                <ComboBoxItem Content="400 кГц" />
                <ComboBoxItem Content="2000 кГц" />
            </ComboBox>
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Text="Ось X:" />
            <ComboBox
                x:Name="XAxisTypeComboBox"
                Width="150"
                AutomationProperties.Name="Тип оси X"
                SelectionChanged="XAxisTypeComboBox_SelectionChanged">
                <ComboBoxItem Content="Номер кадра" />
                <ComboBoxItem Content="Температура" />
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="326" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="4,0,0,0"
                    FontWeight="SemiBold"
                    Text="Доступные кривые" />
                <Border
                    Grid.Row="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <ScrollViewer Padding="6" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CurveItemsPanel" Spacing="2" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="4,0,0,0"
                    FontWeight="SemiBold"
                    Text="Быстрые пресеты" />

                <Grid Grid.Row="1" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="PresetButton_Click"
                        Content="Амплитуды R1"
                        Tag="AllAmplitudesR1" />
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Click="PresetButton_Click"
                        Content="Амплитуды R2"
                        Tag="AllAmplitudesR2" />
                    <Button
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Click="PresetButton_Click"
                        Content="Отн. ампл."
                        Tag="AmplitudeRatios" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Click="PresetButton_Click"
                        Content="Разн. фаз"
                        Tag="PhaseDifferences" />
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="8,5"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="УЭС" />
                            <CheckBox
                                x:Name="RhoFromSondeCheckBox"
                                MinWidth="0"
                                Click="SmtModeCheckBox_Click"
                                Content="на приборе"
                                Tag="RhoSmt:FromSonde" />
                            <CheckBox
                                x:Name="RhoFromComputerCheckBox"
                                MinWidth="0"
                                Click="SmtModeCheckBox_Click"
                                Content="на компьютере"
                                Tag="RhoSmt:FromComputer" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="8,5"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Симм. фазы" />
                            <CheckBox
                                x:Name="PhaseFromSondeCheckBox"
                                MinWidth="0"
                                Click="SmtModeCheckBox_Click"
                                Content="на приборе"
                                Tag="PhaseSmt:FromSonde" />
                            <CheckBox
                                x:Name="PhaseFromComputerCheckBox"
                                MinWidth="0"
                                Click="SmtModeCheckBox_Click"
                                Content="на компьютере"
                                Tag="PhaseSmt:FromComputer" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="PresetButton_Click"
                        Content="Ампл. молч."
                        Tag="SilentAmplitudes" />
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Click="PresetButton_Click"
                        Content="Разность фаз молч."
                        FontSize="12"
                        Tag="SilentPhaseDifference" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ApplyButton"
                        Width="120"
                        Height="40"
                        Click="ApplyButton_Click"
                        Content="Применить"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Width="120"
                        Height="40"
                        Click="CancelButton_Click"
                        Content="Отмена" />
                </StackPanel>
            </Grid>

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Height="40"
                HorizontalAlignment="Stretch"
                Click="PresetButton_Click"
                Content="Температура"
                Tag="Temperature" />
        </Grid>
    </Grid>
</Window>
